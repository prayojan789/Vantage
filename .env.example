# ─────────────────────────────────────────────
#  VANTAGE — Environment Variables
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+psycopg://vantage:vantage_pass@localhost:5432/vantage_db
DATABASE_URL_SYNC=postgresql+psycopg://vantage:vantage_pass@localhost:5432/vantage_db

# ── Redis (Celery broker) ─────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider Toggle ───────────────────────
# Options: "openai" | "ollama"
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (local) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── App Settings ─────────────────────────────
APP_NAME=VANTAGE
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000"]

# ── Scraper Settings ──────────────────────────
SCRAPE_INTERVAL_MINUTES=30
MAX_ARTICLES_PER_CRAWL=50

# ── Clustering Settings ───────────────────────
SIMILARITY_THRESHOLD=0.82
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=VANTAGE
